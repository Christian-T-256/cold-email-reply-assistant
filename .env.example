APP_MODE=demo
DATABASE_PATH=.data/replies.db

# Required when APP_MODE=live
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-sonnet-4-5
EMAIL_API_BASE_URL=https://api.email-platform.example/v1
EMAIL_API_KEY=your_email_platform_api_key
EMAIL_API_TIMEOUT_SECONDS=20
APP_ACCESS_TOKEN=replace_with_a_long_random_value

# Sender voice and factual offer context
SENDER_NAME=Morgan Lee
SENDER_EMAIL=morgan@example.com
SENDER_OFFER_SUMMARY="We turn scattered customer feedback into a concise weekly decision brief."
SENDER_VOICE_NOTES="Short, plain, specific, and calm. Never pushy."
